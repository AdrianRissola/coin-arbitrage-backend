{
  "name": "coin-arbitrer",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "test": "node test/backend/run.cjs",
    "test2": "node test/backend/run.cjs --detect-open-handles",
    "test:unit": "node test/backend/run.cjs --suite unit",
    "test:services": "node test/backend/run.cjs --suite services",
    "test:schema": "node test/backend/run.cjs --suite schema",
    "test:all": "node test/backend/run.cjs --suite all",
    "test:ci": "node test/backend/run.cjs --suite all --coverage --detect-open-handles",
    "test:lint": "eslint --no-cache --ext .js,.cjs --max-warnings 0 test/backend test/integration-contracts",
    "test:api": "node test/backend/run.cjs --suite api",
    "test:websocket": "node test/backend/run.cjs --suite websocket",
    "test:websocket-wire": "node test/backend/run.cjs --suite websocket-wire",
    "test:persistence": "node test/backend/run.cjs --suite persistence",
    "test:coverage": "node test/backend/run.cjs --coverage",
    "test:security": "node --test test/security.test.cjs",
    "test:bootstrap": "node --test test/integration-contracts/bootstrap.test.cjs",
    "test:fixtures": "node test/integration-contracts/verify.cjs",
    "test:int": "node test/integration-contracts/run.cjs",
    "test:int:coverage": "node test/integration-contracts/run.cjs --coverage --detect-open-handles"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.22.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^28.1.2",
    "nodemon": "^1.3.3",
    "prettier": "2.7.1",
    "supertest": "^6.2.4"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "cors": "2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "mongoose": "^6.4.1",
    "node-cache": "^5.1.2",
    "websocket": "^1.0.34"
  },
  "jest": {
    "testEnvironment": "node",
    "watchman": false,
    "globalSetup": "<rootDir>/test/backend/support/require-runner.cjs"
  }
}
